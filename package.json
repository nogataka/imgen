{
  "name": "@nogataka/imgen",
  "version": "0.4.0",
  "description": "OpenAI / Azure OpenAI 画像生成・編集・説明CLIツール - gpt-image-1.5 / gpt-5.1",
  "type": "module",
  "bin": {
    "imgen": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./sdk": {
      "import": "./dist/sdk.js",
      "types": "./dist/sdk.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "build": "tsup src/index.ts src/sdk.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "check-all": "npm run check && npm run lint && npm run format:check && npm run test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "image",
    "ai",
    "azure",
    "openai",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nogataka/imgen.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "openai": "^4.80.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}
